# SmartSight AI - Environment Configuration Example
# Copy this file to .env and configure your local settings.

# Optional: Google Gemini API Key for strategic LLM executive briefings
# SmartSight AI operates 100% offline using its built-in rule engine if this key is omitted.
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Database Settings
DATABASE_PATH=web_app/backend/smartsight.db
